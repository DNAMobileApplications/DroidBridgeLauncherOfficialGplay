<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Network/auth/download access. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Rust Craft's LAN games: hearing the worlds other players open to LAN
         (their 224.0.2.60:4445 announcements) needs Wi-Fi multicast. -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

    <!-- Foreground installation progress service. -->
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE"
        tools:ignore="ForegroundServicesPolicy" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />

    <!-- Android 13+ notification permission for visible install progress notifications. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Not required (Play would hide the app from devices without them):
         the landscape-only screens (sensorLandscape) imply a landscape screen,
         the Wi-Fi permissions (LAN games) imply Wi-Fi, and RECORD_AUDIO
         implies a microphone. Phones, tablets, Chromebooks and XR all qualify. -->
    <uses-feature
        android:name="android.hardware.screen.landscape"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.screen.portrait"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.wifi"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.microphone"
        android:required="false" />

    <!-- Optional: gyro camera control. Never filter out devices without a gyroscope. -->
    <uses-feature
        android:name="android.hardware.sensor.gyroscope"
        android:required="false" />
    <!-- Optional: the Horizon (Rust) engine prefers Vulkan and falls back to OpenGL ES 3. -->
    <uses-feature
        android:name="android.hardware.vulkan.level"
        android:required="false"
        android:version="1" />
    <!-- Scoped storage uses SAF tree URI grants. Do not request MANAGE_EXTERNAL_STORAGE for Play Store builds. -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!-- Android 11+ package visibility for renderer and Vulkan driver plugins. -->
    <queries>
        <!-- MobileGL official plugin app. -->
        <package android:name="top.mobilegl.plugin" />

        <!-- MobileGlues official plugin app. -->
        <package android:name="com.fcl.plugin.mobileglues" />

        <!-- Krypton / NGG plugin variants. -->
        <package android:name="com.bzlzhh.plugin.ngg" />
        <package android:name="com.bzlzhh.plugin.ngg.angleless" />

        <package android:name="com.fcl.plugin.renderer.mobileglues" />
        <package android:name="com.fcl.plugin.renderer.ltw" />
        <package android:name="com.fcl.plugin.renderer.gl4es" />
        <package android:name="com.fcl.plugin.renderer.angle" />
        <package android:name="com.fcl.plugin.renderer.mesa" />

        <!-- Vulkan / Turnip driver plugin packages for Vulkan Zink. -->
        <package android:name="com.fcl.plugin.driver.freedreno" />
        <package android:name="com.fcl.plugin.driver.turnip" />
        <package android:name="com.fcl.plugin.turnip" />
        <package android:name="com.fcl.plugin.adreno" />
        <package android:name="com.bzlzhh.plugin.driver.freedreno" />
        <package android:name="com.bzlzhh.plugin.driver.turnip" />
        <package android:name="com.bzlzhh.plugin.turnip" />
        <package android:name="com.bzlzhh.plugin.adreno" />
        <package android:name="com.tungsten.fcl.plugin.driver.freedreno" />
        <package android:name="com.tungsten.fcl.plugin.driver.turnip" />
        <package android:name="ca.dnamobile.renderer.litegles" />
        <provider android:authorities="ca.dnamobile.renderer.litegles.settings" />
        <!-- FFmpeg companion plugin packages.
             Keep all known release/debug package variants visible on Android 11+.
             The release plugin is ca.dnamobile.dbridgelauncher.ffmpeg, but debug
             and local companion builds can use a suffixed package name. -->
        <package android:name="ca.dnamobile.javalauncher.ffmpeg" />
        <package android:name="ca.dnamobile.javalauncher.ffmpeg.debug" />
        <package android:name="ca.dnamobile.javalauncher.debug.ffmpeg" />
        <package android:name="ca.dnamobile.javalauncher.ffmpegplugin" />
        <package android:name="ca.dnamobile.javalauncher.ffmpegplugin.debug" />

        <!-- Optional FFmpeg plugin discovery intents.
             These do not replace exact package queries; they only make future
             companion builds visible if they expose a plugin/discovery action. -->
        <intent>
            <action android:name="ca.dnamobile.javalauncher.ffmpeg.PLUGIN" />
        </intent>
        <intent>
            <action android:name="ca.dnamobile.javalauncher.FFMPEG_PLUGIN" />
        </intent>


        <!-- Android 11+ package visibility for Android TextToSpeech engines.
             Required so TextToSpeech can discover/bind the system TTS service. -->
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
        <intent>
            <action android:name="android.speech.tts.engine.CHECK_TTS_DATA" />
        </intent>
        <intent>
            <action android:name="android.speech.tts.engine.INSTALL_TTS_DATA" />
        </intent>
        <package android:name="com.google.android.tts" />
        <package android:name="com.samsung.SMT" />
        <package android:name="com.svox.pico" />

        <!-- Fallback visibility for plugin/driver apps with launcher activities. -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:allowAudioPlaybackCapture="true"
        android:allowNativeHeapPointerTagging="false"
        android:appCategory="game"
        android:icon="@mipmap/ic_launcher_droidbridge"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_droidbridge_round"
        android:supportsRtl="false"
        android:theme="@style/Theme.DroidBridge"
        tools:targetApi="30">

        <!-- AppAuth redirect receiver. Kept for AppAuth/custom redirect compatibility. -->
        <activity
            android:name="net.openid.appauth.RedirectUriReceiverActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data android:scheme="${appAuthRedirectScheme}" />
            </intent-filter>
        </activity>

        <!-- Main launcher flow. -->
        <activity
            android:name=".SplashActivity"
            android:configChanges="keyboard|keyboardHidden|uiMode"
            android:screenOrientation="fullSensor"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".MainActivity"
            android:configChanges="keyboard|keyboardHidden|uiMode"
            android:screenOrientation="unspecified"
            android:exported="false">
            <property
                android:name="android.window.PROPERTY_COMPAT_ALLOW_RESTRICTED_RESIZABILITY"
                android:value="true" />
        </activity>
        <activity
            android:name=".DroidBridgeStandaloneJarActivity"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize|smallestScreenSize"
            android:exported="false"
            android:hardwareAccelerated="false"
            android:process=":java_gui"
            android:screenOrientation="landscape" />
        <!-- Android home screen shortcut entry.
             This is exported only so the user's launcher app can open pinned
             instance shortcuts. It immediately hands off to MainActivity. -->
        <activity
            android:name=".InstanceShortcutActivity"
            android:configChanges="keyboard|keyboardHidden|uiMode"
            android:screenOrientation="fullSensor"
            android:excludeFromRecents="true"
            android:exported="true"
            android:noHistory="true" />

        <!-- Front-end picker used by Kid Emu and similar launchers.
             DroidBridge owns the instance list, so front ends should ask DroidBridge
             to let the parent choose an instance instead of asking for raw IDs. -->
        <activity
            android:name=".InstancePickerActivity"
            android:configChanges="keyboard|keyboardHidden|uiMode"
            android:screenOrientation="fullSensor"
            android:excludeFromRecents="true"
            android:exported="true"
            android:noHistory="true">
            <intent-filter>
                <action android:name="ca.dnamobile.droidbridgelauncher.action.PICK_INSTANCE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <activity
            android:name=".launcher.DroidBridgeLaunchActivity"
            android:configChanges="keyboard|keyboardHidden|uiMode"
            android:screenOrientation="unspecified"
            android:exported="false">
            <property
                android:name="android.window.PROPERTY_COMPAT_ALLOW_RESTRICTED_RESIZABILITY"
                android:value="true" />
        </activity>
        <activity
            android:name=".ModpackUpdateDetailsActivity"
            android:screenOrientation="fullSensor"
            android:exported="false" />

        <activity
            android:name=".LauncherSettingsActivity"
            android:configChanges="keyboard|keyboardHidden|uiMode"
            android:screenOrientation="fullSensor"
            android:exported="false" />

        <activity
            android:name=".InstanceDetailsActivity"
            android:configChanges="keyboard|keyboardHidden|uiMode"
            android:screenOrientation="fullSensor"
            android:exported="false" />

        <activity
            android:name=".ContentBrowserActivity"
            android:configChanges="keyboard|keyboardHidden|uiMode"
            android:screenOrientation="fullSensor"
            android:exported="false" />
        <activity
            android:name=".input.GamepadMappingTransferActivity"
            android:configChanges="keyboard|keyboardHidden|uiMode"
            android:screenOrientation="fullSensor"
            android:exported="false" />


        <activity
            android:name=".ContentProjectDetailsActivity"
            android:configChanges="keyboard|keyboardHidden|uiMode"
            android:screenOrientation="fullSensor"
            android:exported="false" />
        <activity
            android:name=".settings.SimpleVoiceChatPermissionActivity"
            android:screenOrientation="sensorLandscape"
            android:exported="false" />
        <activity
            android:name=".fancymenu.MicrosoftAuthActivity"
            android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:exported="false"
            android:screenOrientation="behind" />

        <!-- Native exit hook / clean game-exit screen. -->
        <activity
            android:name=".ErrorActivity"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize|touchscreen|uiMode"
            android:excludeFromRecents="true"
            android:exported="false"
            android:screenOrientation="sensorLandscape" />

        <!-- Game process. -->
        <activity
            android:name=".GameActivity"
            android:supportsPictureInPicture="true"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize|touchscreen|uiMode"
            android:exported="false"
            android:process=":game"
            android:screenOrientation="sensorLandscape" />

        <!-- Minecraft screen + selected game/microphone audio recorder. Keep this OUTSIDE :game so
             Minecraft/JVM shutdown cannot kill MediaMuxer before the MP4 footer is written
             and the MediaStore IS_PENDING row is published. -->
        <service
            android:name=".recording.GameRecordingService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection|microphone"
            android:process=":recording"
            android:stopWithTask="false" />

        <!-- Rust Craft engine: Minecraft Java rewritten in Rust, offered per instance, a title
             update for each version: TU1 for vanilla 1.0 (RustcraftActivity), TU2 for 1.1
             (RustcraftTu2Activity), TU3 for 1.2.5 (RustcraftTu3Activity), TU4 for 1.3.2
             (RustcraftTu4Activity), TU5 for 1.4.7 (RustcraftTu5Activity),
             TU6 for 1.5.2 (RustcraftTu6Activity), TU7 for 1.6.4 (RustcraftTu7Activity). Enabled only in builds that bundle librustcraft_android.so
             (app/build.gradle). RustcraftLaunchActivity checks the account in the launcher
             process, then starts RustcraftActivity in :rustcraft; that process ends when the
             player quits, which returns them here. -->
        <activity
            android:name=".engine.rustcraft.RustcraftLaunchActivity"
            android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:enabled="${rustcraftEngineEnabled}"
            android:excludeFromRecents="true"
            android:exported="false"
            android:theme="@style/Theme.DroidBridge.HorizonHandoff" />
        <activity
            android:name="dev.rustcraft.android.RustcraftActivity"
            android:supportsPictureInPicture="true"
            android:resizeableActivity="true"
            android:taskAffinity="${applicationId}.rustcraft"
            android:configChanges="density|keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize|touchscreen|uiMode"
            android:enabled="${rustcraftEngineEnabled}"
            android:exported="false"
            android:process=":rustcraft"
            android:screenOrientation="sensorLandscape"
            android:theme="@style/HorizonGameTheme"
            android:windowSoftInputMode="adjustResize">
            <meta-data
                android:name="android.app.lib_name"
                android:value="rustcraft_android" />
        </activity>
        <!-- Rust Craft TU2 (Minecraft 1.1): the same host as RustcraftActivity (TU1, 1.0), on its
             own library, librustcraft_tu2.so, since a NativeActivity takes its library from its
             own entry here. RustcraftLaunchActivity starts the title update an instance's
             Minecraft version needs (engine/rustcraft/RustcraftEngine). -->
        <activity
            android:name="dev.rustcraft.android.RustcraftTu2Activity"
            android:supportsPictureInPicture="true"
            android:resizeableActivity="true"
            android:taskAffinity="${applicationId}.rustcraft"
            android:configChanges="density|keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize|touchscreen|uiMode"
            android:enabled="${rustcraftEngineEnabled}"
            android:exported="false"
            android:process=":rustcraft"
            android:screenOrientation="sensorLandscape"
            android:theme="@style/HorizonGameTheme"
            android:windowSoftInputMode="adjustResize">
            <meta-data
                android:name="android.app.lib_name"
                android:value="rustcraft_tu2" />
        </activity>
        <!-- Rust Craft TU3 (Minecraft 1.2.5): the same host as RustcraftActivity (TU1, 1.0), on its
             own library, librustcraft_tu3.so, since a NativeActivity takes its library from its
             own entry here. RustcraftLaunchActivity starts the title update an instance's
             Minecraft version needs (engine/rustcraft/RustcraftEngine). -->
        <activity
            android:name="dev.rustcraft.android.RustcraftTu3Activity"
            android:supportsPictureInPicture="true"
            android:resizeableActivity="true"
            android:taskAffinity="${applicationId}.rustcraft"
            android:configChanges="density|keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize|touchscreen|uiMode"
            android:enabled="${rustcraftEngineEnabled}"
            android:exported="false"
            android:process=":rustcraft"
            android:screenOrientation="sensorLandscape"
            android:theme="@style/HorizonGameTheme"
            android:windowSoftInputMode="adjustResize">
            <meta-data
                android:name="android.app.lib_name"
                android:value="rustcraft_tu3" />
        </activity>
        <!-- Rust Craft TU4 (Minecraft 1.3.2): the same host as RustcraftActivity (TU1, 1.0), on its
             own library, librustcraft_tu4.so, since a NativeActivity takes its library from its
             own entry here. RustcraftLaunchActivity starts the title update an instance's
             Minecraft version needs (engine/rustcraft/RustcraftEngine). -->
        <activity
            android:name="dev.rustcraft.android.RustcraftTu4Activity"
            android:supportsPictureInPicture="true"
            android:resizeableActivity="true"
            android:taskAffinity="${applicationId}.rustcraft"
            android:configChanges="density|keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize|touchscreen|uiMode"
            android:enabled="${rustcraftEngineEnabled}"
            android:exported="false"
            android:process=":rustcraft"
            android:screenOrientation="sensorLandscape"
            android:theme="@style/HorizonGameTheme"
            android:windowSoftInputMode="adjustResize">
            <meta-data
                android:name="android.app.lib_name"
                android:value="rustcraft_tu4" />
        </activity>
        <!-- Rust Craft TU5 (Minecraft 1.4.7): the same host as RustcraftActivity (TU1, 1.0), on its
             own library, librustcraft_tu5.so, since a NativeActivity takes its library from its
             own entry here. RustcraftLaunchActivity starts the title update an instance's
             Minecraft version needs (engine/rustcraft/RustcraftEngine). -->
        <activity
            android:name="dev.rustcraft.android.RustcraftTu5Activity"
            android:supportsPictureInPicture="true"
            android:resizeableActivity="true"
            android:taskAffinity="${applicationId}.rustcraft"
            android:configChanges="density|keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize|touchscreen|uiMode"
            android:enabled="${rustcraftEngineEnabled}"
            android:exported="false"
            android:process=":rustcraft"
            android:screenOrientation="sensorLandscape"
            android:theme="@style/HorizonGameTheme"
            android:windowSoftInputMode="adjustResize">
            <meta-data
                android:name="android.app.lib_name"
                android:value="rustcraft_tu5" />
        </activity>
        <!-- Rust Craft TU6 (Minecraft 1.5.2): the same host as RustcraftActivity (TU1, 1.0), on its
             own library, librustcraft_tu6.so, since a NativeActivity takes its library from its
             own entry here. RustcraftLaunchActivity starts the title update an instance's
             Minecraft version needs (engine/rustcraft/RustcraftEngine). -->
        <activity
            android:name="dev.rustcraft.android.RustcraftTu6Activity"
            android:supportsPictureInPicture="true"
            android:resizeableActivity="true"
            android:taskAffinity="${applicationId}.rustcraft"
            android:configChanges="density|keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize|touchscreen|uiMode"
            android:enabled="${rustcraftEngineEnabled}"
            android:exported="false"
            android:process=":rustcraft"
            android:screenOrientation="sensorLandscape"
            android:theme="@style/HorizonGameTheme"
            android:windowSoftInputMode="adjustResize">
            <meta-data
                android:name="android.app.lib_name"
                android:value="rustcraft_tu6" />
        </activity>
        <!-- Rust Craft TU7 (Minecraft 1.6.4): the same host as RustcraftActivity (TU1, 1.0), on its
             own library, librustcraft_tu7.so, since a NativeActivity takes its library from its
             own entry here. RustcraftLaunchActivity starts the title update an instance's
             Minecraft version needs (engine/rustcraft/RustcraftEngine). -->
        <activity
            android:name="dev.rustcraft.android.RustcraftTu7Activity"
            android:supportsPictureInPicture="true"
            android:resizeableActivity="true"
            android:taskAffinity="${applicationId}.rustcraft"
            android:configChanges="density|keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize|touchscreen|uiMode"
            android:enabled="${rustcraftEngineEnabled}"
            android:exported="false"
            android:process=":rustcraft"
            android:screenOrientation="sensorLandscape"
            android:theme="@style/HorizonGameTheme"
            android:windowSoftInputMode="adjustResize">
            <meta-data
                android:name="android.app.lib_name"
                android:value="rustcraft_tu7" />
        </activity>

        <!-- Horizon engine: Minecraft Java 26.3 rewritten in Rust, offered per instance.
             Enabled only in builds that bundle libhorizon_android.so (app/build.gradle).
             HorizonLaunchActivity runs the account preflight in the launcher process, then
             starts HorizonActivity in :horizon. The engine owns one native window per process
             and ends that process when the player quits, which returns them here. -->
        <activity
            android:name=".engine.horizon.HorizonLaunchActivity"
            android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:enabled="${horizonEngineEnabled}"
            android:excludeFromRecents="true"
            android:exported="false"
            android:theme="@style/Theme.DroidBridge.HorizonHandoff" />
        <activity
            android:name="dev.horizon.android.HorizonActivity"
            android:supportsPictureInPicture="true"
            android:resizeableActivity="true"
            android:taskAffinity="${applicationId}.horizon"
            android:configChanges="density|keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize|touchscreen|uiMode"
            android:enabled="${horizonEngineEnabled}"
            android:exported="false"
            android:process=":horizon"
            android:screenOrientation="sensorLandscape"
            android:theme="@style/HorizonGameTheme"
            android:windowSoftInputMode="adjustResize">
            <meta-data
                android:name="android.app.lib_name"
                android:value="horizon_android" />
        </activity>
        <!-- First-launch download of Minecraft 26.3 for Horizon. In :horizon, so the engine
             library never loads into the launcher; DroidBridge shows the progress. -->
        <service
            android:name=".engine.horizon.HorizonInstallService"
            android:enabled="${horizonEngineEnabled}"
            android:exported="false"
            android:process=":horizon" />
        <provider
            android:name="dev.horizon.android.HorizonDocumentsProvider"
            android:authorities="${applicationId}.horizon.documents"
            android:enabled="${horizonEngineEnabled}"
            android:exported="true"
            android:grantUriPermissions="true"
            android:permission="android.permission.MANAGE_DOCUMENTS"
            android:process=":horizon">
            <intent-filter>
                <action android:name="android.content.action.DOCUMENTS_PROVIDER" />
            </intent-filter>
        </provider>
        <!-- Horizon Add-ons: an instance's Horizon mods, native-mod switches and shader packs.
             The provider runs the game's own file checks in :horizon, so the engine library
             never loads into the launcher. -->
        <activity
            android:name=".engine.horizon.HorizonAddonsActivity"
            android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:enabled="${horizonEngineEnabled}"
            android:exported="false"
            android:screenOrientation="fullSensor" />
        <provider
            android:name="dev.horizon.android.HorizonAddonsProvider"
            android:authorities="${applicationId}.horizon.addons"
            android:enabled="${horizonEngineEnabled}"
            android:exported="false"
            android:process=":horizon" />

        <!-- Controller editor screens. -->
        <activity
            android:name=".controls.ControlsActivity"
            android:configChanges="keyboardHidden|orientation|screenSize"
            android:exported="false"
            android:screenOrientation="sensorLandscape" />

        <activity
            android:name=".controls.ControlsEditorActivity"
            android:configChanges="keyboardHidden|orientation|screenSize"
            android:exported="false"
            android:screenOrientation="sensorLandscape" />

        <!-- File sharing for logs/exports. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Android DocumentsProvider for exposing launcher-managed files. -->
        <provider
            android:name=".storage.DroidBridgeDocumentsProvider"
            android:authorities="${applicationId}.documents"
            android:exported="true"
            android:grantUriPermissions="true"
            android:permission="android.permission.MANAGE_DOCUMENTS">
            <intent-filter>
                <action android:name="android.content.action.DOCUMENTS_PROVIDER" />
            </intent-filter>
        </provider>

        <service
            android:name=".installation.InstallationForegroundService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>
</manifest>
